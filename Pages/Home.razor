@page "/"
@using LoadoutGenerator.Models
@using LoadoutGenerator.Shared
@inject InventoryService Inventory
@inject LoadoutGeneratorService Generator
@inject HttpClient Http

<PageTitle>Loadout Generator</PageTitle>

<h1>Loadout Generator Prototype</h1>

<FilterEditor Filter="_filter" FilterChanged="OnFilterChanged"/>

<WeaponFilter Filter="_filter" AllWeaponTags="_weaponTags" FilterChanged="OnFilterChanged" />

<button @onclick="GenerateLoadout" class="=btn btn-primary">
    Generate Loadout
</button>

@if (_currentLoadout != null)
{
    <div class="loadout_display">
        <h3>Your Loadout:</h3>
        <div class="weapons">
            <h3>Weapons</h3>
            <p>Primary: @_currentLoadout.Primary.Name</p>
            <p>Secondary: @_currentLoadout.Secondary.Name</p>
        </div>

        <div class="tools">
            <h3>Tools</h3>
            <ul>
                @foreach (var tool in _currentLoadout.Tools)
                {
                    <li>@tool.Name</li>
                }
            </ul>
        </div>

        <div class="Consumables">
            <h3>Consumables</h3>
            <ul>
                @foreach (var consumable in _currentLoadout.Consumables)
                {
                    <li>@consumable.Name</li>
                }
            </ul>
        </div>
    </div>
}

@code{
    private Loadout _currentLoadout;
    private Filters _filter = new();
    private List<string> _weaponTags= ["Shotgun", "Rifle", "Pistol", "Long Ammo", "Medium Ammo", "Small Ammo", "Special Ammo", "Silenced", "Aperture", "Deadeye", "Marksman", "Sniper"];
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await Inventory.LoadInvetoryAsync();
    }
    private void GenerateLoadout()
    {
        _currentLoadout = Generator.GenerateLoadout(_filter);
    }

    private Task OnFilterChanged(Filters newFilter)
    {
        _filter = newFilter;
        return Task.CompletedTask;
    }
}

